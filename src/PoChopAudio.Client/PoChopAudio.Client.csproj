<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoChopAudio.Shared\PoChopAudio.Shared.csproj" />
  </ItemGroup>

  <!--
    The Blazor SDK substitutes `#[.{fingerprint}]` tokens in HTML assets and writes the
    processed copy to `obj/.../htmlassetplaceholders/build/*.html`, but the static-web-assets
    build target copies the unprocessed source `wwwroot/index.html` to the output instead of
    the resolved version. Copy the resolved file back into wwwroot so `dotnet publish` ships
    a page that the browser can actually load.
  -->
  <Target Name="CopyResolvedIndexHtml" AfterTargets="ResolveStaticWebAssetsForPublish">
    <PropertyGroup>
      <_ResolvedHtmlDir>$(IntermediateOutputPath)staticwebassets\htmlassetplaceholders\build\</_ResolvedHtmlDir>
      <_ResolvedHtmlGlob>$(_ResolvedHtmlDir)*.html</_ResolvedHtmlGlob>
    </PropertyGroup>
    <ItemGroup>
      <_ResolvedHtmlFiles Include="$(_ResolvedHtmlGlob)" />
    </ItemGroup>
    <Copy SourceFiles="@(_ResolvedHtmlFiles)"
          DestinationFolder="$(PublishDir)wwwroot\"
          SkipUnchangedFiles="false"
          Condition="'@(_ResolvedHtmlFiles)' != ''" />
  </Target>

</Project>
