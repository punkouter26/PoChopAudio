@page "/cutout"
@page "/headshots"
@using PoChopAudio.Client.Services
@inject CameraCapture Camera
@implements IAsyncDisposable

<PageTitle>Cutout Studio — PoChopAudio</PageTitle>

@*
    Camera and cutout on one page: take a photo, and it drops straight into the results below.

    Everything here runs in the tab. The capture, the ONNX model and the crop all happen in
    browser memory and nothing is ever posted to the API — which is the rule this page inherits
    from the old head-shots page: pictures of someone's face do not leave their machine.
*@

<header class="page-header">
    <h1 class="page-title">Cutout Studio</h1>
    <p class="page-subtitle">
        Take a photo and it is cut out below. Nothing is uploaded — the camera and the model both
        run in this tab.
    </p>
</header>

@if (_supported is false)
{
    <section class="card">
        <p class="warn" role="alert">
            The camera needs permission over a secure connection. This page is on a plain HTTP
            origin, or the browser exposes no camera, so there is nothing to capture here.
        </p>
    </section>
}
else
{
    <section class="card">
        <div class="stage">
            <video @ref="_video" class="preview @(_running ? "live" : "")" playsinline muted></video>

            @if (!_running)
            {
                <div class="stage-idle"><p>Starting camera…</p></div>
            }

            @if (_flash)
            {
                <div class="flash" aria-hidden="true"></div>
            }
        </div>

        <button class="take-photo" @onclick="TakePhotoAsync" disabled="@(_busy || !_running)">
            @(_busy ? "Working…" : "TAKE PHOTO")
        </button>

        @if (_error is not null)
        {
            <p class="warn" role="alert">@_error</p>
        }
    </section>

    @if (_shots.Count > 0)
    {
        <div class="results-head">
            <h2>Results</h2>
            <button class="secondary" @onclick="ClearAsync">Clear</button>
        </div>

        @foreach (var shot in _shots)
        {
            <section class="card shot" @key="shot.Id">
                <div class="shot-head">
                    <div>
                        <strong>@shot.FileName</strong>
                        <span class="meta">@shot.DetailsText</span>
                    </div>
                    @if (shot.CutoutUrl is not null)
                    {
                        <button class="secondary" @onclick="() => SaveAsync(shot)">Save PNG</button>
                    }
                </div>

                <div class="pair">
                    <figure>
                        <figcaption>Original</figcaption>
                        <img src="@shot.OriginalUrl" alt="Captured photo" />
                    </figure>
                    <figure class="checker">
                        <figcaption>Cutout</figcaption>
                        @if (shot.CutoutUrl is not null)
                        {
                            <img src="@shot.CutoutUrl" alt="Photo with the background removed" />
                        }
                        else if (shot.Error is not null)
                        {
                            <p class="warn">@shot.Error</p>
                        }
                        else
                        {
                            <p class="pending">Cutting out…</p>
                        }
                    </figure>
                </div>
            </section>
        }
    }
}

@code {
    private sealed class Shot
    {
        public required string Id { get; init; }
        public required string FileName { get; init; }
        public required string OriginalUrl { get; init; }
        public int Width { get; set; }
        public int Height { get; set; }
        public string? CutoutUrl { get; set; }
        public string? Error { get; set; }

        public string DetailsText => Width > 0 ? $"{Width} × {Height} px" : "…";
    }

    private readonly List<Shot> _shots = [];
    private ElementReference _video;
    private bool? _supported;
    private bool _running;
    private bool _busy;
    private bool _flash;
    private string? _error;

    /// <summary>Padding around the alpha bounding box, in pixels. Matches the old head-shots crop.</summary>
    private const int CropPaddingPx = 24;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _supported = await Camera.IsSupportedAsync();
        StateHasChanged();

        if (_supported is true)
        {
            // Start straight away so TAKE PHOTO is the only control on the page.
            await StartAsync();
        }
    }

    private async Task StartAsync()
    {
        try
        {
            await Camera.StartAsync(_video);
            _running = true;
            _error = null;
        }
        catch (Exception exception)
        {
            _error = $"Could not start the camera: {exception.Message}";
        }

        StateHasChanged();
    }

    private async Task TakePhotoAsync()
    {
        if (_busy || !_running) return;

        _busy = true;
        _error = null;
        _flash = true;
        StateHasChanged();

        try
        {
            var captured = await Camera.CaptureAsync();
            _flash = false;

            var shot = new Shot
            {
                Id = captured.Id,
                FileName = $"photo_{_shots.Count + 1}.png",
                OriginalUrl = captured.OriginalUrl,
                Width = captured.Width,
                Height = captured.Height,
            };

            _shots.Add(shot);
            StateHasChanged();

            try
            {
                var cutout = await Camera.CutoutAsync(shot.Id, CropPaddingPx);
                shot.CutoutUrl = cutout.CutoutUrl;
                shot.Width = cutout.Width;
                shot.Height = cutout.Height;

                if (cutout.EmptyMask)
                {
                    shot.Error = "The model found no subject in this frame.";
                }
            }
            catch (Exception exception)
            {
                shot.Error = exception.Message;
            }
        }
        catch (Exception exception)
        {
            _error = $"Could not take the photo: {exception.Message}";
        }
        finally
        {
            _flash = false;
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsync(Shot shot)
    {
        if (shot.CutoutUrl is null) return;
        await Camera.SaveAsync(shot.CutoutUrl, shot.FileName);
    }

    private async Task ClearAsync()
    {
        await Camera.ClearAsync();
        _shots.Clear();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Camera.StopAsync();
            await Camera.ClearAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; the browser has released everything anyway.
        }
    }
}
