@* The five detection knobs. Used once for the batch and again inside any file that overrides them. *@

<div class="knobs">
    <label>
        <span>Takes expected</span>
        <input type="number" min="1" max="64" step="1" disabled="@Disabled" onwheel="this.blur()"
               value="@Settings.ExpectedSegments" @onchange="OnExpectedChangedAsync" />
    </label>
    <label>
        <span>Shortest take (ms)</span>
        <input type="number" min="10" max="60000" step="10" disabled="@Disabled" onwheel="this.blur()"
               value="@Settings.MinSegmentMs" @onchange="args => OnNumberChangedAsync(args, v => Settings.MinSegmentMs = v)" />
    </label>
    <label>
        <span>Shortest gap (ms)</span>
        <input type="number" min="10" max="60000" step="10" disabled="@Disabled" onwheel="this.blur()"
               value="@Settings.MinGapMs" @onchange="args => OnNumberChangedAsync(args, v => Settings.MinGapMs = v)" />
    </label>
    <label>
        <span>Padding (ms)</span>
        <input type="number" min="0" max="5000" step="5" disabled="@Disabled" onwheel="this.blur()"
               value="@Settings.PadMs" @onchange="args => OnNumberChangedAsync(args, v => Settings.PadMs = v)" />
    </label>
    <label class="wide">
        <span class="threshold-head">
            Threshold @ThresholdLabelText
            <span class="auto">
                <input type="checkbox" @bind="Settings.AutoThreshold" @bind:after="OnAutoChangedAsync" disabled="@Disabled" />
                auto
            </span>
        </span>
        <input type="range" min="-100" max="0" step="0.5" disabled="@(Disabled || Settings.AutoThreshold)"
               value="@ThresholdDisplay.ToString("F1")" @onchange="OnThresholdChangedAsync" />
    </label>
</div>

@code {
    /// <summary>The knob values this panel edits in place.</summary>
    [Parameter, EditorRequired]
    public required ChopSettings Settings { get; set; }

    /// <summary>Slider position to show while auto is on — the gate the detector actually chose.</summary>
    [Parameter]
    public double? AutoThresholdDb { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised after any knob moves, so the owner can re-split.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private double ThresholdDisplay => Settings.AutoThreshold
        ? AutoThresholdDb ?? ChopLimits.DefaultThresholdDb
        : Settings.ThresholdDb;

    private string ThresholdLabelText => Settings.AutoThreshold
        ? (AutoThresholdDb is { } db ? $"{db:F1} dBFS" : "auto")
        : $"{Settings.ThresholdDb:F1} dBFS";

    private async Task OnExpectedChangedAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value))
        {
            Settings.ExpectedSegments = Math.Clamp(value, 1, 64);
            await Changed.InvokeAsync();
        }
    }

    private async Task OnNumberChangedAsync(ChangeEventArgs args, Action<double> apply)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            apply(value);
            await Changed.InvokeAsync();
        }
    }

    private async Task OnAutoChangedAsync()
    {
        // Leaving auto starts the slider where the detector left it, so nothing jumps.
        if (!Settings.AutoThreshold)
        {
            Settings.ThresholdDb = AutoThresholdDb ?? ChopLimits.DefaultThresholdDb;
        }

        await Changed.InvokeAsync();
    }

    private async Task OnThresholdChangedAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            Settings.ThresholdDb = value;
            Settings.AutoThreshold = false;
            await Changed.InvokeAsync();
        }
    }
}
