<Page
    x:Class="PoChopAudio.WinUI.Views.HeadShotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:PoChopAudio.WinUI.Common"
    xmlns:models="using:PoChopAudio.WinUI.Models">

    <Page.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis" />
        <common:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <common:InvertedBoolConverter x:Key="InvertBool" />
        <common:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Title -->
            <StackPanel Spacing="4">
                <TextBlock Text="Take head shots and cut them out" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Shoot a set of portraits. Each one is cut out and cropped to your head on-device with AI. Nothing leaves your PC."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Camera Stage Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Camera Viewfinder with Oval Guide -->
                    <Border Grid.Column="0" Height="320" CornerRadius="8" Background="#0F172A" ClipToBounds="True">
                        <Grid>
                            <CaptureElement x:Name="CameraPreviewElement" Stretch="UniformToFill" />

                            <!-- Head Alignment Oval Guide -->
                            <Ellipse Width="180" Height="240"
                                     Stroke="White" StrokeThickness="2" StrokeDashArray="3,2"
                                     Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False" />

                            <!-- Countdown Overlay -->
                            <Border Background="#B2000000" Visibility="{x:Bind ViewModel.Countdown, Mode=OneWay, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{x:Bind ViewModel.Countdown, Mode=OneWay}"
                                           FontSize="72" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Camera Idle placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
                                <FontIcon Glyph="&#xE722;" FontSize="40" Foreground="#64748B" />
                                <TextBlock Text="Camera is idle" Foreground="#94A3B8" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Camera Controls -->
                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center">
                        <TextBox Header="Headshot Name" Text="{x:Bind ViewModel.HeadShotName, Mode=TwoWay}"
                                 PlaceholderText="e.g. Head" />

                        <RadioButtons Header="Capture Mode" SelectedIndex="{x:Bind CaptureModeIndex, Mode=TwoWay}">
                            <RadioButton Content="Burst — shoot a set automatically with countdown" />
                            <RadioButton Content="Manual — one shot per press" />
                        </RadioButtons>

                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsBurstMode, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Number of Shots" FontWeight="SemiBold" />
                            <NumberBox Value="{x:Bind ViewModel.ShotCount, Mode=TwoWay}"
                                       Minimum="1" Maximum="20" SmallChange="1" SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="📷 Start Camera" Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}"
                                    Click="OnStartCameraClicked" />

                            <Button Content="📸 Shoot Headshots" Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind ViewModel.ShootCommand}" />

                            <Button Content="Stop Camera"
                                    Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                    Command="{x:Bind ViewModel.StopCameraCommand}" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                                   Foreground="#EF4444" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Headshots Gallery -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20"
                    Visibility="{x:Bind ViewModel.HeadShots.Count, Mode=OneWay, Converter={StaticResource NullToVis}}">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Captured Head Shots" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="Save All to Folder…" Click="OnSaveAllToFolderClicked" />
                            <Button Content="Clear All" Command="{x:Bind ViewModel.ClearAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Gallery Grid -->
                    <GridView ItemsSource="{x:Bind ViewModel.HeadShots}" SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="models:HeadShotItem">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Width="180" Padding="8" Margin="4">
                                    <StackPanel Spacing="8">
                                        <Border Height="180" CornerRadius="6" Background="#1E293B" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="Uniform" />
                                                <ProgressRing IsActive="{x:Bind IsProcessing, Mode=OneWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind Width, Mode=OneWay}" /> × <Run Text="{x:Bind Height, Mode=OneWay}" /> px
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button Content="💾 Save" Click="OnSaveHeadshotClicked" HorizontalAlignment="Stretch" />
                                            <Button Content="🗑" Click="OnDeleteHeadshotClicked" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>

