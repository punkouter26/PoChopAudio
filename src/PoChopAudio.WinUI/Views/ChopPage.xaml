<Page
    x:Class="PoChopAudio.WinUI.Views.ChopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PoChopAudio.WinUI.Controls"
    xmlns:common="using:PoChopAudio.WinUI.Common"
    xmlns:models="using:PoChopAudio.WinUI.Models">

    <Page.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis" />
        <common:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <common:InvertedBoolConverter x:Key="InvertBool" />
        <common:NullToVisibilityConverter x:Key="NullToVis" />
        <common:LabelWithValueConverter x:Key="RowLabel" />
    </Page.Resources>

    <!-- Horizontal scrolling stays Disabled so content can never measure wider than the viewport. -->
    <ScrollViewer Padding="24,16,24,32"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Center">

            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Record and split" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Record yourself making sounds. Each sound is split into its own WAV automatically."
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1" x:Name="ClearButton"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.StartOverCommand}"
                        AutomationProperties.Name="Clear everything and start again"
                        ToolTipService.ToolTip="Drop everything and start again">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Step 1: record. The whole point of the page, so it gets the space. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24,20">
                <StackPanel Spacing="14">

                    <TextBox x:Name="TakeNameBox"
                             Header="Name these sounds"
                             PlaceholderText="e.g. Footsteps"
                             FontSize="16"
                             Text="{x:Bind ViewModel.RecordingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource InvertBool}}" />

                    <controls:LevelMeter x:Name="MicLevelMeter" />

                    <!-- Record / Stop. One big target; the two states swap in place. -->
                    <Button x:Name="RecordBtn"
                            HorizontalAlignment="Stretch" Height="52"
                            Style="{ThemeResource AccentButtonStyle}"
                            Background="#DC2626"
                            Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}"
                            Command="{x:Bind ViewModel.StartRecordingCommand}"
                            AutomationProperties.Name="Start recording">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7C8;" FontSize="16" />
                            <TextBlock Text="Record" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button HorizontalAlignment="Stretch" Height="52"
                            Style="{ThemeResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                            Command="{x:Bind ViewModel.StopRecordingCommand}"
                            AutomationProperties.Name="Stop recording and split it into sounds">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE71A;" FontSize="16" />
                            <TextBlock Text="Stop and split" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Only shown when the missing name is what is blocking Record. -->
                    <TextBlock Text="Enter a name above to start recording."
                               FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.NeedsRecordingName, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{x:Bind ViewModel.RecordingElapsed, Mode=OneWay}"
                                   FontFamily="Consolas" FontWeight="Bold" FontSize="20"
                                   Foreground="#DC2626" VerticalAlignment="Center"
                                   AutomationProperties.Name="Time recorded" />
                        <TextBlock Text="Leave a gap of silence between each sound."
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Importing a file is still possible, just not the headline. -->
                    <Border x:Name="DropArea" AllowDrop="True"
                            DragOver="OnDragOver" Drop="OnDrop"
                            Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Center">
                        <HyperlinkButton Content="or open an audio file you already have"
                                         FontSize="12"
                                         AutomationProperties.Name="Open an audio file from disk"
                                         Click="OnBrowseFilesClicked" />
                    </Border>

                    <ProgressBar IsIndeterminate="True"
                                 AutomationProperties.Name="Working"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                               AutomationProperties.LiveSetting="Assertive"
                               Foreground="#EF4444" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!--
                Between "app opened" and "first take recorded" the page was blank below the
                record card, which reads as something failing rather than nothing having
                happened yet. This says what to do instead.
            -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24"
                    Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8D6;" FontSize="28" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No sounds yet" HorizontalAlignment="Center" FontWeight="SemiBold" />
                    <TextBlock Text="Name your sounds, press Record, and make each one with a clear pause in between. Every sound is split into its own WAV and lands here."
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Step 2: the sounds that came out, and one button to save them all. -->
            <Grid ColumnSpacing="12"
                  Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Your sounds" Style="{ThemeResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" />
                <controls:WrapPanel Grid.Column="1" HorizontalSpacing="8" VerticalSpacing="8">
                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Click="OnSaveAllToFolderClicked"
                            AutomationProperties.Name="Save every sound as a WAV into a folder"
                            ToolTipService.ToolTip="Write every sound as its own WAV into a folder you pick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save all to folder..." />
                        </StackPanel>
                    </Button>
                    <Button Click="OnExportBatchZipClicked"
                            AutomationProperties.Name="Save every sound together as one ZIP"
                            ToolTipService.ToolTip="Download every sound together as a single ZIP">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                            <TextBlock Text="Download ZIP" />
                        </StackPanel>
                    </Button>
                </controls:WrapPanel>
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChopFileItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel Spacing="10">

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="15"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Background="#F59E0B" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                    Visibility="{x:Bind Warning, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{x:Bind Warning}" Foreground="Black" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind SummaryText, Mode=OneWay}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Play all" Click="OnPlayOriginalClicked"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind FileName, Converter={StaticResource RowLabel}, ConverterParameter=Play the whole recording of}" />
                                </Grid>

                                <controls:WaveformView Item="{x:Bind}" SegmentClicked="OnWaveformSegmentClicked" />

                                <!-- One row per detected sound. Mode=OneWay matters: x:Bind inside a
                                     DataTemplate is OneTime by default, so this bound the empty
                                     collection the item was created with and never showed the
                                     sounds that analysis found a moment later. -->
                                <ItemsControl ItemsSource="{x:Bind Segments, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    CornerRadius="4" Padding="10,7" Margin="0,2">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        Sound <Run Text="{Binding Index}" />
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding DurationSeconds}" />s
                                                    </TextBlock>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Play" Click="OnPlayTakeItemClicked"
                                                                AutomationProperties.Name="{Binding Index, Converter={StaticResource RowLabel}, ConverterParameter=Play sound}" />
                                                        <Button Content="Save" Click="OnSaveTakeItemClicked"
                                                                AutomationProperties.Name="{Binding Index, Converter={StaticResource RowLabel}, ConverterParameter=Save sound}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Per-file tuning, out of the way until the split is wrong -->
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Header="Split came out wrong?">
                                    <StackPanel Spacing="10" Padding="0,4,0,0">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                                <TextBlock Text="How many sounds?" FontSize="12" />
                                                <NumberBox Value="{x:Bind Settings.ExpectedSegments, Mode=TwoWay}"
        AutomationProperties.Name="How many sounds to expect in this recording"
                                                           Minimum="1" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Ignore sounds shorter than (ms)" FontSize="12" />
                                                <Slider Value="{x:Bind Settings.MinSegmentMs, Mode=TwoWay}"
        AutomationProperties.Name="Ignore sounds shorter than, in milliseconds"
                                                        Minimum="10" Maximum="2000" StepFrequency="10" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Minimum gap between sounds (ms)" FontSize="12" />
                                                <Slider Value="{x:Bind Settings.MinGapMs, Mode=TwoWay}"
        AutomationProperties.Name="Minimum gap between sounds, in milliseconds"
                                                        Minimum="10" Maximum="2000" StepFrequency="10" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Breathing room around each sound (ms)" FontSize="12" />
                                                <Slider Value="{x:Bind Settings.PadMs, Mode=TwoWay}"
        AutomationProperties.Name="Breathing room around each sound, in milliseconds"
                                                        Minimum="0" Maximum="500" StepFrequency="5" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Split again" Style="{ThemeResource AccentButtonStyle}"
                                                Click="OnResplitSingleFileClicked" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Everything power-user, collapsed. Nothing here is needed for a normal take. -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Header="Advanced settings"
                      Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="14" Padding="0,4,0,0">

                    <TextBlock Text="Splitting" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Sounds Expected" FontWeight="SemiBold" />
                            <NumberBox Value="{x:Bind ViewModel.BatchKnobs.ExpectedSegments, Mode=TwoWay}"
        AutomationProperties.Name="How many sounds to expect in every recording"
                                       Minimum="1" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock Text="Shortest Sound" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.MinSegmentMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.MinSegmentMs, Mode=TwoWay}"
        AutomationProperties.Name="Shortest sound, in milliseconds"
                                    Minimum="10" Maximum="2000" StepFrequency="10" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <Grid>
                                <TextBlock Text="Shortest Gap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.MinGapMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.MinGapMs, Mode=TwoWay}"
        AutomationProperties.Name="Shortest gap, in milliseconds"
                                    Minimum="10" Maximum="2000" StepFrequency="10" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Grid>
                                <TextBlock Text="Padding" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.PadMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.PadMs, Mode=TwoWay}"
        AutomationProperties.Name="Padding around each sound, in milliseconds"
                                    Minimum="0" Maximum="500" StepFrequency="5" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock Text="Threshold" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.BatchKnobs.AutoThreshold, Mode=TwoWay}"
        AutomationProperties.Name="Choose the detection threshold automatically"
                                              OnContent="Auto" OffContent="Manual" HorizontalAlignment="Right" MinWidth="0" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.ThresholdDb, Mode=TwoWay}"
        AutomationProperties.Name="Detection threshold, in decibels"
                                    Minimum="-80" Maximum="0" StepFrequency="0.5"
                                    IsEnabled="{x:Bind ViewModel.BatchKnobs.AutoThreshold, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                            <Grid>
                                <TextBlock Text="Trim Silence" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.TrimSilenceMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.TrimSilenceMs, Mode=TwoWay}"
        AutomationProperties.Name="Trim silence, in milliseconds"
                                    Minimum="0" Maximum="1000" StepFrequency="50" />
                        </StackPanel>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <TextBlock Text="Export Polish" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Normalize Mode" FontWeight="SemiBold" />
                            <ComboBox SelectedIndex="{x:Bind ExportNormalizeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Off (Pass-through)" />
                                <ComboBoxItem Content="Peak (Loudest sample)" />
                                <ComboBoxItem Content="RMS (Average power)" />
                                <ComboBoxItem Content="Loudness (LUFS standard)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock Text="Target Level" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ExportKnobs.TargetDb, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.ExportKnobs.TargetDb, Mode=TwoWay}"
        AutomationProperties.Name="Normalize target level, in decibels"
                                    Minimum="-40" Maximum="0" StepFrequency="0.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <Grid>
                                <TextBlock Text="Ceiling" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ExportKnobs.CeilingDb, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.ExportKnobs.CeilingDb, Mode=TwoWay}"
        AutomationProperties.Name="Peak ceiling, in decibels"
                                    Minimum="-12" Maximum="0" StepFrequency="0.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="4">
                            <Grid>
                                <TextBlock Text="Edge Fades (ms)" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ExportKnobs.FadeInMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.ExportKnobs.FadeInMs, Mode=TwoWay}"
        AutomationProperties.Name="Edge fade length, in milliseconds"
                                    Minimum="0" Maximum="50" StepFrequency="1" />
                        </StackPanel>
                    </Grid>

                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button Content="Re-split All" Command="{x:Bind ViewModel.ResplitAllCommand}" />
                        <Button Content="Reset settings to defaults" Command="{x:Bind ViewModel.ResetSettingsCommand}" />
                    </controls:WrapPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
