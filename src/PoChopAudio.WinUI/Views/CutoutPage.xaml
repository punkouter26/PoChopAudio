<Page
    x:Class="PoChopAudio.WinUI.Views.CutoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PoChopAudio.WinUI.Controls"
    xmlns:common="using:PoChopAudio.WinUI.Common"
    xmlns:models="using:PoChopAudio.WinUI.Models">

    <Page.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis" />
        <common:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <common:InvertedBoolConverter x:Key="InvertBool" />
        <common:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- ── Camera ───────────────────────────────────────────────────── -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">

                    <Grid Height="380" CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Image x:Name="PreviewImage" Stretch="Uniform"
                               Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsCameraRunning, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}">
                            <FontIcon Glyph="&#xE722;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Starting camera…" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Button Content="TAKE PHOTO" Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" Height="56" FontSize="16" FontWeight="SemiBold"
                            Command="{x:Bind ViewModel.TakePhotoCommand}"
                            IsEnabled="{x:Bind ViewModel.IsCapturing, Mode=OneWay, Converter={StaticResource InvertBool}}" />

                    <!--
                        The Health page used to be where a missing model was reported. With that page
                        gone this is the only place the user would find out, so it says so inline.
                    -->
                    <Border Background="#33EF4444" CornerRadius="6" Padding="12"
                            Visibility="{x:Bind ViewModel.IsCutoutAvailable, Converter={StaticResource InvertedBoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                   Text="Background removal is unavailable: u2netp.onnx is missing. Run SCRIPTS/download-models.ps1, then restart." />
                    </Border>

                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                               Foreground="#EF4444" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- ── Fine tune ────────────────────────────────────────────────── -->
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Header="Fine tune"
                      Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="12">

                    <controls:WrapPanel ItemWidth="260" ItemHeight="66" HorizontalSpacing="16" VerticalSpacing="8">

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Cutoff" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.Tuning.AlphaThreshold, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.Tuning.AlphaThreshold, Mode=TwoWay}"
                                    Minimum="0" Maximum="255" StepFrequency="5" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Tighten / loosen" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.Tuning.Morphology, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.Tuning.Morphology, Mode=TwoWay}"
                                    Minimum="-3" Maximum="3" StepFrequency="1" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Soften edge" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.Tuning.FeatherRadius, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.Tuning.FeatherRadius, Mode=TwoWay}"
                                    Minimum="0" Maximum="5" StepFrequency="1" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Head cut (%)" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.Tuning.HeadCutBias, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.Tuning.HeadCutBias, Mode=TwoWay}"
                                    Minimum="-40" Maximum="40" StepFrequency="5" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Padding (px)" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.Tuning.CropPadding, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.Tuning.CropPadding, Mode=TwoWay}"
                                    Minimum="0" Maximum="200" StepFrequency="4" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Edge" FontWeight="SemiBold" />
                            <ToggleSwitch IsOn="{x:Bind ViewModel.Tuning.HardEdge, Mode=TwoWay}"
                                          OnContent="Sharp" OffContent="Soft" MinWidth="0" />
                        </StackPanel>
                    </controls:WrapPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Re-apply to all" Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ReapplyAllCommand}" />
                        <Button Content="Reset" Command="{x:Bind ViewModel.ResetTuningCommand}" />
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Cutoff decides what counts as background. Sharp edge removes the halo around hair; soften only if it looks too cut-out. Head cut moves the neck line up or down." />
                </StackPanel>
            </Expander>

            <!-- ── Results ──────────────────────────────────────────────────── -->
            <Grid Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Results" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Save All to Folder..." Click="OnSaveAllToFolderClicked" />
                    <Button Content="Clear" Command="{x:Bind ViewModel.ClearAllCommand}" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CutoutFileItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel Spacing="12">

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind DetailsText, Mode=OneWay}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="Save PNG..." Click="OnSaveSingleCutoutClicked" />
                                </Grid>

                                <controls:BeforeAfterView Item="{x:Bind}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
