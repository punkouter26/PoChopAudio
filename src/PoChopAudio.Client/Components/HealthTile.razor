@* One subsystem card on the health dashboard. *@

<div class="health-card @(Ok ? "ok" : "fail")">
    <div class="health-head">
        <span class="health-icon" aria-hidden="true">@Icon</span>
        <span class="health-title">@Title</span>
        <span class="health-pill @(Ok ? "ok" : "fail")">@StatusText</span>
    </div>
    <div class="health-body">
        <span class="health-detail">@Detail</span>
    </div>
    @if (LatencyMs is { } ms)
    {
        <div class="health-foot">
            <span class="health-lat">@ms<span class="health-lat-unit">ms</span></span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required string Icon { get; set; }
    [Parameter, EditorRequired] public required bool Ok { get; set; }
    [Parameter, EditorRequired] public required string StatusText { get; set; }
    [Parameter] public string? Detail { get; set; }
    [Parameter] public long? LatencyMs { get; set; }
}
