<Page
    x:Class="PoChopAudio.WinUI.Views.HeadShotsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PoChopAudio.WinUI.Controls"
    xmlns:common="using:PoChopAudio.WinUI.Common"
    xmlns:models="using:PoChopAudio.WinUI.Models"
    xmlns:shared="using:PoChopAudio.Shared">

    <Page.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis" />
        <common:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <common:InvertedBoolConverter x:Key="InvertBool" />
        <common:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Title -->
            <StackPanel Spacing="4">
                <TextBlock Text="Take head shots and cut them out" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Shoot a set of portraits."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Camera Stage" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Image x:Name="CameraPreviewImage" Stretch="UniformToFill" Height="200" />
                    <Button Content="Start Camera" Click="OnStartCameraClicked" />
                </StackPanel>
            </Border>

            <!-- Items -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.HeadShots}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:HeadShotItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{x:Bind DimensionsText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
