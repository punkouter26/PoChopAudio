<Page
    x:Class="PoChopAudio.WinUI.Views.ChopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PoChopAudio.WinUI.Controls"
    xmlns:common="using:PoChopAudio.WinUI.Common"
    xmlns:models="using:PoChopAudio.WinUI.Models">

    <Page.Resources>
        <common:BoolToVisibilityConverter x:Key="BoolToVis" />
        <common:BoolToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <common:InvertedBoolConverter x:Key="InvertBool" />
        <common:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch">

            <!-- Page Title -->
            <StackPanel Spacing="4">
                <TextBlock Text="Chop recordings into takes" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Takes multi-take voiceovers, sound effects or recordings and splits them into clean WAVs per take."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- File Picker / Drop Zone & Recorder Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">

                    <!-- Drop Zone / Browse Button -->
                    <Border x:Name="DropArea" AllowDrop="True"
                            DragOver="OnDragOver" Drop="OnDrop"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="24,20">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Drop audio files here or browse from your computer"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Supports WAV, MP3, AIFF, M4A, AAC, WMA — up to 32 files per batch"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <Button Content="Browse Audio Files" Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,4,0,0"
                                    Click="OnBrowseFilesClicked" />
                        </StackPanel>
                    </Border>

                    <!-- Recorder Panel -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0" Grid.Column="0" Header="Take / File Name"
                                     PlaceholderText="e.g. Nick_Happy"
                                     Text="{x:Bind ViewModel.RecordingName, Mode=TwoWay}"
                                     IsEnabled="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource InvertBool}}" />

                            <!-- Real-time Level Meter -->
                            <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                <controls:LevelMeter x:Name="MicLevelMeter" />
                            </StackPanel>

                            <!-- Record / Stop Buttons -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button x:Name="RecordBtn" Content="Record"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Background="#DC2626"
                                        Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource InvertedBoolToVis}}"
                                        Command="{x:Bind ViewModel.StartRecordingCommand}" />

                                <Button Content="Stop Recording"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                        Command="{x:Bind ViewModel.StopRecordingCommand}" />
                            </StackPanel>

                            <!-- Countdown and elapsed time indicators -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16"
                                        Visibility="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Bind ViewModel.RecordingElapsed, Mode=OneWay}"
                                           FontFamily="Consolas" FontWeight="Bold" FontSize="16" Foreground="#DC2626" VerticalAlignment="Center" />
                                <TextBlock Text="Recording live from microphone..." VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Busy / Status message -->
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                               Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToVis}}"
                               Foreground="#EF4444" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <!-- Batch Settings Card (Visible if files present) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20"
                    Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock Text="Batch Settings" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FilesSummaryText, Mode=OneWay}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <!-- Batch Split Knobs Grid -->
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Expected Takes -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Text="Takes Expected" FontWeight="SemiBold" />
                            <NumberBox Value="{x:Bind ViewModel.BatchKnobs.ExpectedSegments, Mode=TwoWay}"
                                       Minimum="1" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Inline" />
                        </StackPanel>

                        <!-- Shortest Take -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock Text="Shortest Take" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.MinSegmentMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.MinSegmentMs, Mode=TwoWay}"
                                    Minimum="10" Maximum="2000" StepFrequency="10" />
                        </StackPanel>

                        <!-- Shortest Gap -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <Grid>
                                <TextBlock Text="Shortest Gap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.MinGapMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.MinGapMs, Mode=TwoWay}"
                                    Minimum="10" Maximum="2000" StepFrequency="10" />
                        </StackPanel>

                        <!-- Padding -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Grid>
                                <TextBlock Text="Padding" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.PadMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.PadMs, Mode=TwoWay}"
                                    Minimum="0" Maximum="500" StepFrequency="5" />
                        </StackPanel>

                        <!-- Threshold Mode & Slider -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock Text="Threshold" FontWeight="SemiBold" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.BatchKnobs.AutoThreshold, Mode=TwoWay}"
                                              OnContent="Auto" OffContent="Manual" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.ThresholdDb, Mode=TwoWay}"
                                    Minimum="-80" Maximum="0" StepFrequency="0.5"
                                    IsEnabled="{x:Bind ViewModel.BatchKnobs.AutoThreshold, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                        </StackPanel>

                        <!-- Trim Silence -->
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                            <Grid>
                                <TextBlock Text="Trim Silence" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BatchKnobs.TrimSilenceMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.BatchKnobs.TrimSilenceMs, Mode=TwoWay}"
                                    Minimum="0" Maximum="1000" StepFrequency="50" />
                        </StackPanel>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Export Knobs -->
                    <TextBlock Text="Export Polish" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Normalize Mode" FontWeight="SemiBold" />
                            <ComboBox SelectedIndex="{x:Bind ExportNormalizeIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Off (Pass-through)" />
                                <ComboBoxItem Content="Peak (Loudest sample)" />
                                <ComboBoxItem Content="RMS (Average power)" />
                                <ComboBoxItem Content="Loudness (LUFS standard)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <Grid>
                                <TextBlock Text="Target Level" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ExportKnobs.TargetDb, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.ExportKnobs.TargetDb, Mode=TwoWay}"
                                    Minimum="-40" Maximum="0" StepFrequency="0.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <Grid>
                                <TextBlock Text="Ceiling" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ExportKnobs.CeilingDb, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.ExportKnobs.CeilingDb, Mode=TwoWay}"
                                    Minimum="-12" Maximum="0" StepFrequency="0.5" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="4">
                            <Grid>
                                <TextBlock Text="Edge Fades (ms)" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.ExportKnobs.FadeInMs, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Value="{x:Bind ViewModel.ExportKnobs.FadeInMs, Mode=TwoWay}"
                                    Minimum="0" Maximum="50" StepFrequency="1" />
                        </StackPanel>
                    </Grid>

                    <!-- Batch Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Re-split All" Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ResplitAllCommand}" />
                        <Button Content="Save All to Folder..."
                                Click="OnSaveAllToFolderClicked" />
                        <Button Content="Download All as ZIP"
                                Click="OnExportBatchZipClicked" />
                        <Button Content="Reset Settings"
                                Command="{x:Bind ViewModel.ResetSettingsCommand}" />
                        <Button Content="Clear All"
                                Command="{x:Bind ViewModel.ClearAllCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- File Cards List -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ChopFileItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel Spacing="12">

                                <!-- Card Header -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind FileName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TakesCountText, Mode=OneWay}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#F59E0B" CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                    Visibility="{x:Bind Warning, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{x:Bind Warning}" Foreground="Black" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind AudioInfoText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Header Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Play Original"
                                                Click="OnPlayOriginalClicked" />
                                        <ToggleButton IsChecked="{x:Bind IsExpanded, Mode=TwoWay}"
                                                      Content="Tune knobs" />
                                    </StackPanel>
                                </Grid>

                                <!-- Interactive Waveform View -->
                                <controls:WaveformView Item="{x:Bind}" SegmentClicked="OnWaveformSegmentClicked" />

                                <!-- Per-File Knobs (Collapsible) -->
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12"
                                        Visibility="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="File specific overrides" FontWeight="SemiBold" />
                                            <Button Content="Follow batch settings" HorizontalAlignment="Right"
                                                    Visibility="{x:Bind UsesOwnSettings, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                    Click="OnFollowBatchClicked" />
                                        </Grid>

                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Expected takes" FontSize="11" />
                                                <NumberBox Value="{x:Bind Settings.ExpectedSegments, Mode=TwoWay}"
                                                           Minimum="1" Maximum="64" SmallChange="1" SpinButtonPlacementMode="Inline" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Shortest take (ms)" FontSize="11" />
                                                <Slider Value="{x:Bind Settings.MinSegmentMs, Mode=TwoWay}"
                                                        Minimum="10" Maximum="2000" StepFrequency="10" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Shortest gap (ms)" FontSize="11" />
                                                <Slider Value="{x:Bind Settings.MinGapMs, Mode=TwoWay}"
                                                        Minimum="10" Maximum="2000" StepFrequency="10" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Padding (ms)" FontSize="11" />
                                                <Slider Value="{x:Bind Settings.PadMs, Mode=TwoWay}"
                                                        Minimum="0" Maximum="500" StepFrequency="5" />
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Re-split This File" Style="{ThemeResource AccentButtonStyle}"
                                                Click="OnResplitSingleFileClicked" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>

                                <!-- Takes List -->
                                <ItemsControl ItemsSource="{x:Bind Segments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    CornerRadius="4" Padding="8,6" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        Take <Run Text="{Binding Index}" />
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                        <Run Text="{Binding StartSeconds}" />s – 
                                                        <Run Text="{Binding EndSeconds}" />s 
                                                        (<Run Text="{Binding DurationSeconds}" />s) · 
                                                        Peak <Run Text="{Binding PeakDb}" /> dB
                                                    </TextBlock>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Play" Click="OnPlayTakeItemClicked" />
                                                        <Button Content="Save WAV..." Click="OnSaveTakeItemClicked" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>

