@* Four knobs for the cutout mask. Same shape as ChopKnobs so the cutout card stays consistent. *@

@code {
    [Parameter, EditorRequired]
    public required CutoutOptions Options { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback Changed { get; set; }

    private async Task OnThresholdAsync(ChangeEventArgs args)
    {
        if (byte.TryParse(args.Value?.ToString(), out var v))
        {
            Options = Options with { AlphaThreshold = v };
            await Changed.InvokeAsync();
        }
    }

    private async Task OnFeatherAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var v))
        {
            Options = Options with { FeatherRadius = v };
            await Changed.InvokeAsync();
        }
    }

    private async Task OnMorphologyAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var v))
        {
            Options = Options with { Morphology = v };
            await Changed.InvokeAsync();
        }
    }

    private async Task OnMultiplierAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            Options = Options with { AlphaMultiplier = v };
            await Changed.InvokeAsync();
        }
    }

    private async Task OnTrimAsync(ChangeEventArgs args)
    {
        Options = Options with { TrimTransparentEdges = (bool)(args.Value ?? false) };
        await Changed.InvokeAsync();
    }

    private async Task OnTrimPaddingAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var v))
        {
            Options = Options with { TrimPaddingPx = v };
            await Changed.InvokeAsync();
        }
    }
}

<section class="knobs">
    <label class="knob">
        <span class="knob-label">Alpha threshold</span>
        <input type="range" min="0" max="255" step="1" value="@Options.AlphaThreshold"
               disabled="@Disabled" @oninput="OnThresholdAsync" />
        <span class="knob-value">@Options.AlphaThreshold</span>
    </label>

    <label class="knob">
        <span class="knob-label">Feather (px)</span>
        <input type="range" min="0" max="5" step="1" value="@Options.FeatherRadius"
               disabled="@Disabled" @oninput="OnFeatherAsync" />
        <span class="knob-value">@Options.FeatherRadius</span>
    </label>

    <label class="knob">
        <span class="knob-label">Mask size (-3 to +3)</span>
        <input type="range" min="-3" max="3" step="1" value="@Options.Morphology"
               disabled="@Disabled" @oninput="OnMorphologyAsync" />
        <span class="knob-value">@Options.Morphology</span>
    </label>

    <label class="knob">
        <span class="knob-label">Alpha multiplier</span>
        <input type="range" min="0.5" max="2" step="0.05" value="@Options.AlphaMultiplier.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
               disabled="@Disabled" @oninput="OnMultiplierAsync" />
        <span class="knob-value">@Options.AlphaMultiplier.ToString("F2")</span>
    </label>

    <label class="knob knob-toggle">
        <span class="knob-label">Trim transparent edges</span>
        <input type="checkbox" checked="@Options.TrimTransparentEdges"
               disabled="@Disabled" @onchange="OnTrimAsync" />
    </label>

    <label class="knob">
        <span class="knob-label">Trim padding (px)</span>
        <input type="range" min="0" max="128" step="4" value="@Options.TrimPaddingPx"
               disabled="@Disabled" @oninput="OnTrimPaddingAsync" />
        <span class="knob-value">@Options.TrimPaddingPx</span>
    </label>
</section>
