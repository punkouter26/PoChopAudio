@page "/"
@using PoChopAudio.Client.Components
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>PoChopAudio</PageTitle>

<h1>Chop recordings into takes</h1>

<section class="card">
    <label class="picker">
        <InputFile OnChange="OnFilesSelectedAsync" multiple
                   accept="@_accept" disabled="@_busy" />
        <span class="hint">
            @AcceptHint
        </span>
    </label>

    @if (_busy)
    {
        <p class="status" role="status">@_status</p>
    }

    @if (_error is not null)
    {
        <p class="error" role="alert">@_error</p>
    }

    <RecorderPanel Busy="@_busy" SuggestName="UniqueName" Recorded="OnRecordedAsync" />
</section>

@if (_files.Count > 0)
{
    <section class="card">
        <header class="card-head">
            <h2>Batch settings</h2>
            <span class="meta">@Summary</span>
        </header>

        <p class="hint">These apply to every file that has not been tuned on its own.</p>

        <ChopKnobs Settings="_shared" Disabled="@_busy" Changed="OnBatchKnobChangedAsync" />

        <h3>Export</h3>
        <p class="hint">
            Applied to every download below. These do not change the split, so nothing is re-analysed.
        </p>

        <ExportKnobs Settings="_export" Disabled="@_busy" Changed="OnExportChanged" />

        <div class="actions">
            <button type="button" class="primary" @onclick="ResplitAllAsync" disabled="@(_busy || ResplitTargetCount == 0)" title="@ResplitAllTitle">
                @ResplitAllButtonText
            </button>
            <button type="button" @onclick="ResetSharedAsync" disabled="@_busy">Reset settings</button>
            @if (ReadyFiles.Count > 0)
            {
                <a class="button primary" href="@BatchZipUrl">
                    Download @ReadyClips clip@(ReadyClips == 1 ? "" : "s") as ZIP
                </a>
            }
            <button type="button" @onclick="ClearAsync" disabled="@_busy">Clear all</button>
        </div>

        @if (AttentionCount > 0)
        {
            <p class="warn" role="alert">
                @AttentionCount of @_files.Count file(s) did not split cleanly. They are flagged below and
                still included in the ZIP — open one to re-tune it on its own.
            </p>
        }
    </section>

    @foreach (var file in _files)
    {
        <ChopFileCard @key="file"
                      File="file"
                      Busy="@_busy"
                      Export="_export"
                      Resplit="ResplitOneAsync"
                      FollowBatch="FollowBatchAsync" />
    }
}

@code {
    private readonly List<ChopFileState> _files = [];

    private ChopSettings _shared = ChopSettings.Defaults();

    /// <summary>Batch-wide export knobs. Changing these rewrites the download URLs and nothing else.</summary>
    private ExportSettings _export = new();

    private bool _busy;
    private string _status = string.Empty;
    private string? _error;

    /// <summary>Token cancelled whenever a newer analyze starts; stale responses drop themselves.</summary>
    private CancellationTokenSource _analyzeCts = new();

    /// <summary>Coalesces batch-knob and per-file knob changes into one re-split after dragging stops.</summary>
    private readonly Debouncer _resplit = new(TimeSpan.FromMilliseconds(300));

    /// <summary>Marks a re-split request as stale so a late HTTP response does not overwrite the UI.</summary>
    private int _analyzeEpoch;

    /// <summary>Accept attribute for the file picker; mirrors what the API can actually decode.</summary>
    private string _accept = ".wav,.mp3,.aiff,.aif";

    private string AcceptHint =>
        _capabilities is { } caps
            ? $"Pick one or more recordings — each is split on its own, up to {caps.MaxBatchFiles} at a time. Supported here: {caps.Description}."
            : "Pick one or more recordings — each is split on its own. Supported formats load once the server is reachable.";

    private ChopCapabilities? _capabilities;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Http.GetFromJsonAsync<ChopCapabilities>("api/chop/capabilities");
            _accept = string.Join(',', _capabilities?.SupportedExtensions ?? []);
        }
        catch (HttpRequestException)
        {
            // Server not reachable yet; the picker falls back to the universal subset.
            _accept = ".wav,.mp3,.aiff,.aif";
        }
    }

    public async ValueTask DisposeAsync()
    {
        _analyzeCts.Cancel();
        _analyzeCts.Dispose();
        await Task.CompletedTask;
    }

    private IReadOnlyList<ChopFileState> ReadyFiles => [.. _files.Where(f => f.IsReady)];

    private int TotalClips => _files.Sum(f => f.Segments.Count);

    /// <summary>Only the clips that will actually be in the batch ZIP.</summary>
    private int ReadyClips => ReadyFiles.Sum(f => f.Segments.Count);

    private int AttentionCount => _files.Count(f => f.NeedsAttention);

    private int ResplitTargetCount => _files.Count(f => !f.UsesOwnSettings && f.Upload is not null);

    private string ResplitAllButtonText => ResplitTargetCount == _files.Count
        ? "Re-split all"
        : $"Re-split batch ({ResplitTargetCount})";

    private string ResplitAllTitle => ResplitTargetCount < _files.Count
        ? $"{_files.Count - ResplitTargetCount} file(s) are individually tuned and skipped by batch re-split. Click 'Follow batch settings' on a file card to re-include it."
        : "Re-split all recordings using current batch settings";

    private string Summary =>
        $"{_files.Count} file(s) · {TotalClips} clip(s) · {_files.Count(f => f.UsesOwnSettings)} tuned individually";

    private string BatchZipUrl
    {
        get
        {
            var v = ReadyFiles.Count == 0 ? 0 : ReadyFiles.Sum(f => f.Version);
            var url = "api/chop/clips.zip?v=" + v + "&"
                + string.Join('&', ReadyFiles.Select(f => $"jobs={f.Upload!.JobId}"));

            return _export.ToQuery() is { Length: > 0 } query ? $"{url}&{query}" : url;
        }
    }

    /// <summary>
    /// Export knobs only rewrite the download links, so this is a re-render and nothing more —
    /// no debounce, no server round trip, no re-split.
    /// </summary>
    private void OnExportChanged() => StateHasChanged();

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        _error = null;

        var availableSlots = ChopLimits.MaxBatchFiles - _files.Count;
        if (availableSlots <= 0)
        {
            _error = $"Batch limit reached (maximum {ChopLimits.MaxBatchFiles} files allowed). Click Clear all to start a new batch.";
            return;
        }

        IReadOnlyList<IBrowserFile> picked;
        try
        {
            picked = args.GetMultipleFiles(availableSlots);
        }
        catch (InvalidOperationException)
        {
            _error = $"Cannot add that many files. Only {availableSlots} slot(s) remaining (maximum {ChopLimits.MaxBatchFiles}).";
            return;
        }

        if (picked.Count == 0)
        {
            return;
        }

        var startIndex = _files.Count;
        var newStates = new List<ChopFileState>();
        foreach (var file in picked)
        {
            var state = new ChopFileState
            {
                FileName = file.Name,
                SizeBytes = file.Size,
                Settings = _shared.Clone(),
                Expanded = (startIndex == 0 && picked.Count == 1),
            };
            _files.Add(state);
            newStates.Add(state);
        }

        _busy = true;

        try
        {
            // Sequential on purpose: each file is buffered whole before it is posted, and the server
            // decodes on a worker thread. Uploading three 250 MB files at once helps nobody.
            for (var i = 0; i < picked.Count; i++)
            {
                _status = $"Decoding {picked[i].Name} ({i + 1} of {picked.Count})…";
                StateHasChanged();

                await UploadAsync(picked[i], newStates[i]);

                if (newStates[i].Status is not ChopFileStatus.Failed)
                {
                    _status = $"Finding takes in {picked[i].Name} ({i + 1} of {picked.Count})…";
                    StateHasChanged();
                    await AnalyzeAsync(newStates[i]);
                }
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UploadAsync(IBrowserFile source, ChopFileState file)
    {
        if (source.Size > ChopLimits.MaxUploadBytes)
        {
            Fail(file, $"Larger than the {ChopLimits.MaxUploadBytes / (1024 * 1024)} MB limit.");
            return;
        }

        try
        {
            using var buffer = new MemoryStream();
            await using (var stream = source.OpenReadStream(ChopLimits.MaxUploadBytes))
            {
                await stream.CopyToAsync(buffer);
            }

            buffer.Position = 0;
            await PostUploadAsync(buffer, source.Name, file);
        }
        catch (Exception exception)
        {
            Fail(file, $"Upload failed: {exception.Message}");
        }
    }

    /// <summary>
    /// The one path to the server. A recording arrives here as WAV bytes the browser encoded, so
    /// from this point on it is indistinguishable from a file the user picked — same decode, same
    /// detection, same clip naming.
    /// </summary>
    private async Task PostUploadAsync(Stream content, string fileName, ChopFileState file)
    {
        file.Status = ChopFileStatus.Uploading;

        try
        {
            using var form = new MultipartFormDataContent
            {
                { new StreamContent(content), "file", fileName },
            };

            using var response = await Http.PostAsync("api/chop/upload", form);
            if (!response.IsSuccessStatusCode)
            {
                Fail(file, await DescribeFailureAsync(response));
                return;
            }

            file.Upload = await response.Content.ReadFromJsonAsync<UploadResult>();
        }
        catch (Exception exception)
        {
            Fail(file, $"Upload failed: {exception.Message}");
        }
    }

    /// <summary>
    /// Gives a new recording a name nothing else in the batch is using. The server's
    /// <c>UniqueStems</c> would keep the ZIP safe regardless, but a name collision resolved
    /// silently at download time is a poor way to learn two takes share a name.
    /// </summary>
    private string UniqueName(string wanted)
    {
        var taken = _files
            .Select(f => Path.GetFileNameWithoutExtension(f.FileName))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!taken.Contains(wanted))
        {
            return wanted;
        }

        for (var suffix = 2; ; suffix++)
        {
            var candidate = $"{wanted}({suffix})";
            if (!taken.Contains(candidate))
            {
                return candidate;
            }
        }
    }

    /// <summary>Takes a finished recording into the batch and splits it like any other file.</summary>
    private async Task OnRecordedAsync(RecordedTake take)
    {
        _error = null;

        if (_files.Count >= ChopLimits.MaxBatchFiles)
        {
            _error = $"Batch limit reached (maximum {ChopLimits.MaxBatchFiles} files). Click Clear all to start a new batch.";
            return;
        }

        var state = new ChopFileState
        {
            FileName = $"{take.Name}.wav",
            SizeBytes = take.Wav.Length,
            Settings = _shared.Clone(),
            Expanded = true,
        };

        _files.Add(state);
        _busy = true;

        try
        {
            _status = $"Decoding {state.FileName}…";
            StateHasChanged();

            using var buffer = new MemoryStream(take.Wav, writable: false);
            await PostUploadAsync(buffer, state.FileName, state);

            if (state.Status is not ChopFileStatus.Failed)
            {
                _status = $"Finding takes in {state.FileName}…";
                StateHasChanged();
                await AnalyzeAsync(state);
            }
        }
        finally
        {
            _busy = false;
            _status = string.Empty;
        }
    }

    private async Task AnalyzeAsync(ChopFileState file)
    {
        if (file.Upload is not { } upload)
        {
            return;
        }

        file.Status = ChopFileStatus.Splitting;
        file.Error = null;

        var epoch = Interlocked.Increment(ref _analyzeEpoch);
        var token = _analyzeCts.Token;

        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, $"api/chop/{upload.JobId}/analyze")
            {
                Content = JsonContent.Create(file.Settings.ToOptions()),
            };

            using var response = await Http.SendAsync(request, token);

            if (token.IsCancellationRequested || epoch != Volatile.Read(ref _analyzeEpoch))
            {
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                Fail(file, await DescribeFailureAsync(response));
                return;
            }

            file.Analysis = await response.Content.ReadFromJsonAsync<AnalysisResult>(cancellationToken: token);
            if (token.IsCancellationRequested || epoch != Volatile.Read(ref _analyzeEpoch))
            {
                return;
            }

            file.Version++;
            file.Status = ChopFileStatus.Ready;
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer request; drop this result quietly.
        }
        catch (Exception exception)
        {
            if (epoch != Volatile.Read(ref _analyzeEpoch))
            {
                return;
            }

            Fail(file, $"Could not split the recording: {exception.Message}");
        }
    }

    private async Task ResplitOneAsync(ChopFileState file)
    {
        _busy = true;
        _status = $"Re-splitting {file.FileName}…";
        StateHasChanged();

        try
        {
            await AnalyzeAsync(file);
        }
        finally
        {
            _busy = false;
            if (file.Status is ChopFileStatus.Ready or ChopFileStatus.Failed)
            {
                _status = string.Empty;
            }
        }
    }

    private async Task ResplitAllAsync()
    {
        // Files tuned on their own keep what the user gave them.
        var targets = _files.Where(f => !f.UsesOwnSettings && f.Upload is not null).ToArray();

        _busy = true;

        try
        {
            for (var i = 0; i < targets.Length; i++)
            {
                targets[i].Settings = _shared.Clone();
                _status = $"Re-splitting {targets[i].FileName} ({i + 1} of {targets.Length})…";
                StateHasChanged();
                await AnalyzeAsync(targets[i]);
            }
        }
        finally
        {
            _busy = false;
            _status = string.Empty;
        }
    }

    private async Task FollowBatchAsync(ChopFileState file)
    {
        file.UsesOwnSettings = false;
        file.Settings = _shared.Clone();
        await ResplitOneAsync(file);
    }

    private async Task ResetSharedAsync()
    {
        _shared = ChopSettings.Defaults();
        await ResplitAllAsync();
    }

    private async Task ClearAsync()
    {
        await DiscardJobsAsync();
        _files.Clear();
        _error = null;
        _status = string.Empty;
        _analyzeCts.Cancel();
        _analyzeCts = new CancellationTokenSource();
    }

    /// <summary>Batch knob changed: coalesce the deluge into one re-split once dragging stops.</summary>
    private async Task OnBatchKnobChangedAsync()
    {
        await _resplit.InvokeAsync(async _ =>
        {
            await InvokeAsync(StateHasChanged);
            await ResplitAllAsync();
        });
    }

    /// <summary>Frees the server's temp copies instead of waiting for them to expire.</summary>
    private async Task DiscardJobsAsync()
    {
        foreach (var file in _files.Where(f => f.Upload is not null))
        {
            try
            {
                using var response = await Http.DeleteAsync($"api/chop/{file.Upload!.JobId}");
            }
            catch (HttpRequestException)
            {
                // The job expires on its own; losing the race is not worth reporting.
            }
            catch (TaskCanceledException)
            {
                // Request aborted (page navigation, etc.) — let the server-side sweep handle it.
            }
        }
    }

    private static void Fail(ChopFileState file, string message)
    {
        file.Status = ChopFileStatus.Failed;
        file.Error = message;
    }

    private static async Task<string> DescribeFailureAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();

        try
        {
            using var problem = System.Text.Json.JsonDocument.Parse(body);
            foreach (var property in new[] { "detail", "title" })
            {
                if (problem.RootElement.TryGetProperty(property, out var value) && value.GetString() is { } text)
                {
                    return text;
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
        }

        return string.IsNullOrWhiteSpace(body) ? $"The server returned {(int)response.StatusCode}." : body;
    }
}
