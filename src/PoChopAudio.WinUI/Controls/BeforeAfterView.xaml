<UserControl
    x:Class="PoChopAudio.WinUI.Controls.BeforeAfterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnSizeChanged">

    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Height="280">
        <Grid x:Name="RootContainer">
            <!-- Checkerboard background for transparency preview -->
            <Grid Background="#1E293B">
                <!-- Side-by-side display -->
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Original Side -->
                    <Border Grid.Column="0" Margin="4" CornerRadius="4" Background="#0F172A">
                        <Grid>
                            <Image x:Name="OriginalImg" Stretch="Uniform"
                                   AutomationProperties.Name="The photo as taken" />
                            <Border Background="#99000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                <TextBlock Text="Original" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Cutout Side -->
                    <Border Grid.Column="1" Margin="4" CornerRadius="4" Background="#0F172A">
                        <Grid>
                            <Image x:Name="CutoutImg" Stretch="Uniform"
                                   AutomationProperties.Name="The same photo with its background removed" />
                            <Border Background="#99000000" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                <TextBlock Text="Cutout" FontSize="11" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>

