@* What happens to a clip on its way out. Batch-wide, and never triggers a re-split. *@
@using PoChopAudio.Client.Models
@using PoChopAudio.Shared

<div class="knobs export">
    <label>
        <span>Normalize</span>
        <select disabled="@Disabled" value="@Settings.Normalize" @onchange="OnModeChangedAsync">
            <option value="@nameof(NormalizeMode.None)">Off — export the raw cut</option>
            <option value="@nameof(NormalizeMode.Peak)">Peak — match the loudest sample</option>
            <option value="@nameof(NormalizeMode.Rms)">RMS — match average power</option>
            <option value="@nameof(NormalizeMode.Lufs)">Loudness — match perceived level (LUFS)</option>
        </select>
    </label>

    @if (Settings.Normalize is not NormalizeMode.None)
    {
        <label class="wide">
            <span class="knob-head">
                Target <strong>@Settings.TargetDb.ToString("F1") @Settings.TargetUnit</strong>
                <span class="hint">@ModeHint</span>
            </span>
            <input type="range"
                   min="@ExportLimits.MinTargetDb" max="@ExportLimits.MaxTargetDb" step="0.5"
                   disabled="@Disabled"
                   value="@Settings.TargetDb.ToString("F1")"
                   @onchange="args => OnNumberChangedAsync(args, v => Settings.TargetDb = v)" />
        </label>

        <label class="wide">
            <span class="knob-head">
                Ceiling <strong>@Settings.CeilingDb.ToString("F1") dBFS</strong>
                <span class="hint">Gain is pulled back rather than allowed to clip, so a clip may land quieter than the target.</span>
            </span>
            <input type="range"
                   min="@ExportLimits.MinCeilingDb" max="@ExportLimits.MaxCeilingDb" step="0.5"
                   disabled="@Disabled"
                   value="@Settings.CeilingDb.ToString("F1")"
                   @onchange="args => OnNumberChangedAsync(args, v => Settings.CeilingDb = v)" />
        </label>
    }

    <label>
        <span>Fade in (ms, 0 = off)</span>
        <input type="number" min="0" max="@ExportLimits.MaxFadeMs" step="5" disabled="@Disabled" onwheel="this.blur()"
               value="@Settings.FadeInMs"
               @onchange="args => OnNumberChangedAsync(args, v => Settings.FadeInMs = v)" />
    </label>

    <label>
        <span>Fade out (ms, 0 = off)</span>
        <input type="number" min="0" max="@ExportLimits.MaxFadeMs" step="5" disabled="@Disabled" onwheel="this.blur()"
               value="@Settings.FadeOutMs"
               @onchange="args => OnNumberChangedAsync(args, v => Settings.FadeOutMs = v)" />
    </label>
</div>

@if (!Settings.IsDefault)
{
    <p class="hint export-note" role="status">
        @SummaryText Downloads update immediately — this changes the export, not the split, so nothing is re-analysed.
    </p>
}

@code {
    /// <summary>The export values this panel edits in place.</summary>
    [Parameter, EditorRequired]
    public required ExportSettings Settings { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised after any knob moves, so the owner can refresh the download links.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private string ModeHint => Settings.Normalize switch
    {
        NormalizeMode.Peak => "Predictable and lossless-feeling, but a quiet take with one loud click stays quiet.",
        NormalizeMode.Rms => "Steadier than peak across takes, and reliable on clips too short to measure as loudness.",
        NormalizeMode.Lufs => "Closest to how loud a take actually sounds. Mono clips read about 3 LU below stereo, so they receive that much more gain.",
        _ => string.Empty,
    };

    private string SummaryText
    {
        get
        {
            var parts = new List<string>(2);

            if (Settings.Normalize is not NormalizeMode.None)
            {
                parts.Add($"Every clip is normalized to {Settings.TargetDb:F1} {Settings.TargetUnit}, never exceeding {Settings.CeilingDb:F1} dBFS");
            }

            if (Settings.FadeInMs > 0 || Settings.FadeOutMs > 0)
            {
                parts.Add($"fades of {Settings.FadeInMs:F0} ms in and {Settings.FadeOutMs:F0} ms out are applied");
            }

            return parts.Count == 0 ? string.Empty : string.Join(", and ", parts) + ".";
        }
    }

    private async Task OnModeChangedAsync(ChangeEventArgs args)
    {
        if (Enum.TryParse<NormalizeMode>(args.Value?.ToString(), out var mode))
        {
            // Jumping from a dBFS target to a LUFS one keeps the number but changes its meaning,
            // so each mode starts from the value that suits it.
            Settings.AdoptDefaultTargetFor(mode);
            await Changed.InvokeAsync();
        }
    }

    private async Task OnNumberChangedAsync(ChangeEventArgs args, Action<double> apply)
    {
        if (double.TryParse(args.Value?.ToString(), out var value))
        {
            apply(value);
            await Changed.InvokeAsync();
        }
    }
}
