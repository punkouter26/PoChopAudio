@* Vertical divider: drag horizontally to reveal the original on the left and the cutout on the right. *@

<div class="before-after" style="--split: @(Split * 100)%">
    <img class="ba-img ba-original" src="@OriginalUrl" alt="Original" draggable="false" />
    <div class="ba-cutout" style="--clip: inset(0 0 0 var(--split))">
        <img class="ba-img ba-cutout-img" src="@CutoutUrl" alt="Cutout" draggable="false" />
    </div>
    <input class="ba-slider"
           type="range" min="0" max="1" step="0.01"
           @bind="Split" @bind:after="OnChanged"
           aria-label="Drag to compare original and cutout" />
    <div class="ba-handle" style="left: var(--split)">
        <span aria-hidden="true">↔</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required string OriginalUrl { get; set; }
    [Parameter, EditorRequired] public required string CutoutUrl { get; set; }
    [Parameter] public EventCallback<double> SplitChanged { get; set; }

    private double Split { get; set; } = 0.5;

    private async Task OnChanged() => await SplitChanged.InvokeAsync(Split);
}
