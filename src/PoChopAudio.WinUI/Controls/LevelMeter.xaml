<UserControl
    x:Class="PoChopAudio.WinUI.Controls.LevelMeter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PoChopAudio.WinUI.Controls">

    <Grid ColumnSpacing="8" Height="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="54" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="MIC" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Height="18">
            <Grid>
                <!-- Level Track -->
                <ProgressBar x:Name="LevelBar" Value="0" Minimum="0" Maximum="100" Height="14" Margin="2"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="Transparent" />
            </Grid>
        </Border>

        <TextBlock x:Name="DbText" Grid.Column="2" Text="-∞ dB" VerticalAlignment="Center" TextAlignment="Right"
                   FontFamily="Consolas, Segoe UI Variable" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border x:Name="ClipBadge" Grid.Column="3" Background="#DC2626" CornerRadius="3" Padding="4,1" Visibility="Collapsed">
            <TextBlock Text="CLIP" FontSize="10" FontWeight="Bold" Foreground="White" />
        </Border>
    </Grid>
</UserControl>

